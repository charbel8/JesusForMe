<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:layoutDirection="rtl"
    android:background="@drawable/background_image">

    <!-- Top panel: Title and back button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:padding="4dp"
        android:background="@android:color/transparent">
        <Button
            android:id="@+id/back"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="@drawable/button_back"
            android:text="" />
        <TextView
            android:id="@+id/title"
            android:layout_width="314dp"
            android:layout_height="match_parent"
            android:layout_gravity="bottom|left"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingStart="60dp"
            android:paddingEnd="60dp"
            android:text="تساعية مار شربل"
            android:textColor="#000000"
            android:textSize="19sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Content: Scrollable text -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:background="@android:color/transparent">
        <TextView
            android:id="@+id/data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="#000000"
            android:text="@string/saintCharbel"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>

    <!-- Bottom panel: Font size controls + Export -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/transparent">

        <!-- Font size controls, centered -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Export button, bottom-right (start, due to RTL) -->
           <Button
               android:id="@+id/export"
               android:layout_width="60dp"
               android:layout_height="60dp"            
               android:layout_margin="8dp"
               android:text="Ex"
               android:textSize="18sp"
               android:textStyle="bold" />
            
            <Button
                android:id="@+id/decreaseFontSize"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:text="A-"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentFontSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="16"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/increaseFontSize"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:text="A+"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
